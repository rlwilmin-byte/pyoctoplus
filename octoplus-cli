#!/usr/bin/env python3
import sys
import os

# Add repo root to python path so it runs out-of-the-box
repo_root = os.path.dirname(os.path.abspath(__file__))
if repo_root not in sys.path:
    sys.path.insert(0, repo_root)

from pyoctoplus.cli import main

if __name__ == "__main__":
    sys.exit(main())
